# ==========================================
# DocFlow Environment Variables Template
# Copy this file to .env and supply values.
# ==========================================

# --- LLM Providers (Zero-cost free tiers) ---
GROQ_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=
OPENROUTER_API_KEY=

# --- Database and Storage ---
DATABASE_URL=postgresql+psycopg://doc:doc@localhost:5432/docflow
STORAGE_BACKEND=local                # local | supabase
LOCAL_STORAGE_DIR=./storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=720

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Optional Google Sheets Export ---
GOOGLE_SERVICE_ACCOUNT_JSON=         # path or JSON string; leave empty to disable

# --- App Settings ---
APP_ENV=development
LOG_LEVEL=INFO
WORKER_CONCURRENCY=1
BACKEND_URL=http://localhost:8000
